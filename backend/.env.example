# === Banco de Dados ===
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/vagoneteiros_db?schema=public"

# === Servidor ===
PORT=3000
FRONTEND_URL="http://localhost:5173"

# === Firebase Admin ===
FIREBASE_PROJECT_ID=vagoneteirosteste
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/serviceAccountKey.json
# Ou via JSON direto (alternativa):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# === Email SMTP ===
EMAIL_USER="seu-email@gmail.com"
EMAIL_PASS="sua-senha-ou-app-password"

# === Google Drive ===
GOOGLE_APPLICATION_CREDENTIALS=secrets/serviceAccountKey.json
GOOGLE_DRIVE_FOLDER_ID="id da pasta no Google Drive"

# === JWT ===
JWT_SECRET=minha-chave-secreta-aqui
