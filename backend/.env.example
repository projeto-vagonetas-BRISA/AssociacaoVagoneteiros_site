# === Banco de Dados ===
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/vagoneteiros_db?schema=public"

# === Servidor ===
PORT=3000
FRONTEND_URL="http://localhost:5173"

# === Firebase Admin (notificações push) ===
FIREBASE_PROJECT_ID=vagoneteirosteste
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/serviceAccountKey.json
# Ou via JSON direto (alternativa):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# === Email SMTP (opcional) ===
EMAIL_USER="seu-email@gmail.com"
EMAIL_PASS="sua-senha-ou-app-password"

# === Google Drive (galeria de fotos) ===
GOOGLE_APPLICATION_CREDENTIALS=secrets/serviceAccountKey.json
GOOGLE_DRIVE_FOLDER_ID="id da pasta no Google Drive"

# === JWT (produção: obrigatório definir uma chave forte!) ===
# JWT_SECRET=minha-chave-secreta-aqui

# === SMTP Gmail (redefinição de senha e confirmação de agendamento) ===
# IMPORTANTE: EMAIL_PASS é uma SENHA DE APLICATIVO (App Password) do Google,
# NÃO a senha normal do Gmail. Sem isso o envio falha com erro 535.
# Como gerar:
#   1. Ative a Verificação em 2 etapas na conta Google (myaccount.google.com/security)
#   2. Vá em https://myaccount.google.com/apppasswords
#   3. Crie uma senha de app, copie os 16 caracteres e cole aqui (sem espaços)
EMAIL_USER=vagoneteiros@gmail.com
EMAIL_PASS=coloque_aqui_a_senha_de_aplicativo
